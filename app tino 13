function italianWordsToNumber(txt){
  let clean=txt.toLowerCase().replace(/[^\w\sàèéìòù]/g,' ').trim();
  let direct=clean.match(/\d+/);
  if(direct)return direct[0];
  const map={zero:0,uno:1,una:1,due:2,tre:3,quattro:4,cinque:5,sei:6,sette:7,otto:8,nove:9,dieci:10,undici:11,dodici:12,tredici:13,quattordici:14,quindici:15,sedici:16,diciassette:17,diciotto:18,diciannove:19,venti:20,trenta:30,quaranta:40,cinquanta:50,sessanta:60,settanta:70,ottanta:80,novanta:90,cento:100};
  for(let [k,v] of Object.entries(map)){
    if(clean.includes(k))return String(v);
  }
  return '';
}

function startVoice(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR)return;
  if(!RECOG){
    RECOG=new SR();
    RECOG.lang='it-IT';
    RECOG.continuous=true;
    RECOG.interimResults=false;
    RECOG.onresult=(e)=>{
      let last=e.results[e.results.length-1];
      if(!last||!last.isFinal)return;
      let cmd=last[0].transcript.toLowerCase().trim();
      handleVoiceCommand(cmd);
    };
    RECOG.onend=()=>{
      if(VOICE_ON && document.getElementById('wizardModal').classList.contains('on')){
        try{RECOG.start();}catch{}
      }else{
        updateVoiceUI(false);
      }
    };
    RECOG.onerror=()=>{};
  }
  VOICE_ON=true;
  updateVoiceUI(true);
  try{RECOG.start();}catch{}
}

function stopVoice(){
  VOICE_ON=false;
  updateVoiceUI(false);
  if(RECOG){try{RECOG.stop();}catch{}}
}

function toggleVoice(){
  if(VOICE_ON)stopVoice();
  else startVoice();
}

function updateVoiceUI(on){
  let b=document.getElementById('voiceBadge');
  if(!b)return;
  b.classList.toggle('active',on);
  b.textContent=on?'🎙️ Voce ON':'🎙️ Voce OFF';
}

function handleVoiceCommand(cmd){
  if(!document.getElementById('wizardModal').classList.contains('on'))return;
  if(cmd.includes('indietro')){
    wizBack();
    return;
  }
  if(WIZ_STEP===1){
    if(cmd.includes('avanti')||cmd.includes('esci')||cmd.includes('fine')||cmd.includes('basta')){
      exitCameraAndNext();
    }
    return;
  }
  if(WIZ_STEP===2){
    if(cmd.includes('sfuso')){
      wizSetSfuso();
      return;
    }
    let num=italianWordsToNumber(cmd);
    if(num){
      document.getElementById('wizSc').value=num;
      WIZ.sc=num;
    }
    if(cmd.includes('avanti')){
      wizNext();
    }
    return;
  }
  if(WIZ_STEP==='2b'){
    if(cmd.includes('avanti')){
      wizNext();
    }else if(cmd.length>1){
      document.getElementById('wizPoSfuso').value=cmd;
    }
    return;
  }
  if(WIZ_STEP===4||WIZ_STEP===5){
    if(cmd.includes('avanti')){
      wizNext();
    }
    return;
  }
  if(WIZ_STEP===6){
    let num=italianWordsToNumber(cmd);
    if(num){
      let el=document.getElementById('wizPrezzo');
      el.value=num+',00';
    }
    if(cmd.includes('salva')||cmd.includes('avanti')||cmd.includes('fine')||cmd.includes('conferma')){
      wizNext();
    }
  }
}

