function openChunkBackup(){
  let total=D.length;
  let totalBytes=D.reduce((acc,o)=>acc+JSON.stringify(o).length,0);
  document.getElementById('bpInfo').textContent=`Totale: ${total} articoli (${(totalBytes/1024/1024).toFixed(2)} MB con foto). Scarica un blocco alla volta.`;
  let chunksEl=document.getElementById('bpChunks');
  if(!total){
    chunksEl.innerHTML='<p style="color:#9aa3b2">Nessun articolo da esportare.</p>';
    document.getElementById('bpActions').innerHTML='';
    document.getElementById('backupPanel').classList.add('on');
    return;
  }
  let html='';
  let numChunks=Math.ceil(total/CHUNK_SIZE);
  for(let i=0;i<numChunks;i++){
    let start=i*CHUNK_SIZE;
    let end=Math.min(start+CHUNK_SIZE,total);
    let slice=D.slice(start,end);
    let mb=(JSON.stringify(slice).length/1024/1024).toFixed(2);
    html+=`<div class="chunkRow"><div><b>Blocco ${i+1}/${numChunks}</b><br><span style="font-size:12px;color:#9aa3b2">Articoli ${start+1}–${end} (${slice.length} ogg • ~${mb} MB)</span></div><button class="y" style="padding:10px 14px;font-size:13px" onclick="downloadChunk(${i})">Scarica JSON</button></div>`;
  }
  chunksEl.innerHTML=html;
  document.getElementById('bpActions').innerHTML=`<button class="c" style="flex:1" onclick="downloadChunk(0)">Scarica Blocco 1</button>`;
  document.getElementById('backupPanel').classList.add('on');
}

function downloadChunk(index){
  let start=index*CHUNK_SIZE;
  let end=Math.min(start+CHUNK_SIZE,D.length);
  let slice=D.slice(start,end);
  if(!slice.length)return;
  let payload={
    app:'L_APP_TINO',
    chunkIndex:index+1,
    totalChunks:Math.ceil(D.length/CHUNK_SIZE),
    range:`${start+1}-${end}`,
    count:slice.length,
    exportedAt:new Date().toISOString(),
    items:slice
  };
  let json=JSON.stringify(payload);
  let blob=new Blob([json],{type:'application/json'});
  let url=URL.createObjectURL(blob);
  let a=document.createElement('a');
  a.href=url;
  a.download=`BACKUP_TINO_BLOCCO_${index+1}_di_${Math.ceil(D.length/CHUNK_SIZE)}_${start+1}-${end}.json`;
  document.body.appendChild(a);
  a.click();
  setTimeout(()=>{document.body.removeChild(a);URL.revokeObjectURL(url);},600);
}

async function doRestoreFile(input){
  let files=[...(input.files||[])];
  if(!files.length)return;
  let map=new Map(D.map(x=>[String(x.id),x]));
  let totalImported=0;
  let errors=[];
  for(let file of files){
    try{
      let txt=await file.text();
      let p=JSON.parse(txt);
      let items=[];
      if(Array.isArray(p)){items=p;}
      else if(p && Array.isArray(p.items)){items=p.items;}
      else if(p && Array.isArray(p.data)){items=p.data;}
      else if(p && Array.isArray(p.beni)){items=p.beni;}
      else{throw new Error('Formato JSON non riconosciuto');}
      items.forEach(it=>{
        if(it && it.id!==undefined){map.set(String(it.id),it);totalImported++;}
      });
    }catch(err){
      errors.push(`${file.name}: ${err.message}`);
    }
  }
  if(!totalImported){
    alert('Nessun articolo importato.'+(errors.length?'\n'+errors.join('\n'):''));
    input.value='';
    return;
  }
  D=[...map.values()].sort((a,b)=>(Number(b.id)||0)-(Number(a.id)||0));
  await saveDB();
  await loadDB();
  let msg=`Ripristino completato: caricati/aggiornati ${totalImported} articoli da ${files.length} file (totale in app: ${D.length}).`;
  if(errors.length)msg+='\nAlcuni file hanno dato errore:\n'+errors.join('\n');
  alert(msg);
  document.getElementById('backupPanel').classList.remove('on');
  input.value='';
}

