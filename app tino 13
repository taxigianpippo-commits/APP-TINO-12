async function togglePers(id){let o=D.find(x=>x.id==id);if(o){o.personal=!o.personal;await saveDB();render();}}
async function toggleFb(id){let o=D.find(x=>x.id==id);if(o){o.fbDone=!o.fbDone;await saveDB();render();}}
async function delItem(id){if(!confirm('Eliminare questo articolo?'))return;D=D.filter(x=>x.id!=id);await saveDB();render();}

async function exportAllZIPSmart(){
  if(typeof JSZip==='undefined'){alert('Libreria ZIP non caricata');return;}
  let list=D.filter(x=>!x.zip && x.st=='mag' && !x.personal);
  if(!list.length){alert('Nessun articolo nuovo da scaricare');return;}
  let zip=new JSZip();
  list.forEach(o=>{
    let cleanBody=cleanFbPromo(o.de||'');
    let cleanDesc=FB_PROMO_TEXT+(cleanBody?'\n\n'+cleanBody:'');
    let folder=zip.folder(`${o.id}_${(o.n||'articolo').replace(/[^a-zA-Z0-9_-]/g,'_').slice(0,30)}`);
    folder.file('info.txt',`Nome: ${o.n}\nScatola: ${o.sc}\nPrezzo: ${o.prc}\nDescrizione:\n${cleanDesc}`);
    (o.im||[]).forEach((b64,i)=>{
      let base64=b64.split(',')[1];
      if(base64)folder.file(`foto_${i+1}.jpg`,base64,{base64:true});
    });
    o.zip=true;
  });
  let blob=await zip.generateAsync({type:'blob'});
  let url=URL.createObjectURL(blob);
  let a=document.createElement('a');a.href=url;a.download=`ZIP_NUOVI_${new Date().toISOString().slice(0,10)}.zip`;
  document.body.appendChild(a);a.click();setTimeout(()=>{document.body.removeChild(a);URL.revokeObjectURL(url);},600);
  await saveDB();render();
}

