function wizAddPhotos(inp){
  let files=[...inp.files].slice(0,MAX_PHOTOS-WIZ.im.length);
  if(!files.length){
    inp.value='';
    return;
  }
  let isCam=(inp.id=='phCamWiz');
  let loaded=0;
  files.forEach(f=>{
    let r=new FileReader();
    r.onload=e=>{
      let img=new Image();
      img.onload=()=>{
        let c=document.createElement('canvas');
        let max=800,w=img.width,h=img.height;
        if(w>max||h>max){if(w>h){h*=max/w;w=max}else{w*=max/h;h=max}}
        c.width=w;c.height=h;
        c.getContext('2d').drawImage(img,0,0,w,h);
        WIZ.im.push(c.toDataURL('image/jpeg',0.6));
        wizRenderThumbs();
        loaded++;
        if(isCam && loaded===files.length && CAM_LOOP && WIZ_STEP===1 && WIZ.im.length<MAX_PHOTOS){
          setTimeout(()=>wizOpenCam(),350);
        }
      };
      img.src=e.target.result;
    };
    r.readAsDataURL(f);
  });
  inp.value='';
}

