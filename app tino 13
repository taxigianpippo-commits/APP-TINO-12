function exportExcel(){
  if(typeof XLSX==='undefined'){alert('Libreria Excel non caricata');return;}
  let rows=D.map(o=>({ID:o.id,Stato:o.st,Nome:o.n,Scatola:o.sc,Prezzo:o.prc,VendutoA:o.soldPrice,Piattaforma:o.soldPlat,Spedizione:o.shipMethod,Personale:o.personal?'SI':'NO',ZIP:o.zip?'SI':'NO'}));
  let ws=XLSX.utils.json_to_sheet(rows);
  let wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'Inventario');
  XLSX.writeFile(wb,`INVENTARIO_TINO_${new Date().toISOString().slice(0,10)}.xlsx`);
}

async function doCompress(){
  if(!confirm('Ricompattare le immagini salvate per risparmiare spazio?'))return;
  for(let o of D){
    if(!Array.isArray(o.im))continue;
    let nextIm=[];
    for(let b64 of o.im){
      await new Promise(res=>{
        let img=new Image();
        img.onload=()=>{
          let c=document.createElement('canvas');let max=700,w=img.width,h=img.height;
          if(w>max||h>max){if(w>h){h*=max/w;w=max}else{w*=max/h;h=max}}
          c.width=w;c.height=h;c.getContext('2d').drawImage(img,0,0,w,h);
          nextIm.push(c.toDataURL('image/jpeg',0.55));res();
        };
        img.onerror=()=>{nextIm.push(b64);res();};
        img.src=b64;
      });
    }
    o.im=nextIm;
  }
  await saveDB();render();alert('Spazio ottimizzato!');
}

async function resetZipFlag(){if(!confirm('Segnare tutti gli articoli come NON scaricati in ZIP?'))return;D.forEach(x=>x.zip=false);await saveDB();render();}

function openStats(){
  document.getElementById('statsModal').classList.add('on');

  let magItems=D.filter(x=>x.st=='mag' && !x.personal);
  let persItems=D.filter(x=>x.st=='mag' && x.personal);
  let shipItems=D.filter(x=>x.st=='ship');
  let venItems=D.filter(x=>x.st=='ven');

  let valMag=magItems.reduce((s,o)=>s+parseEuro(o.prc),0);
  let valPers=persItems.reduce((s,o)=>s+parseEuro(o.prc),0);
  let totVen=venItems.reduce((s,o)=>s+parseEuro(o.soldPrice),0);
  let totShip=shipItems.reduce((s,o)=>s+parseEuro(o.soldPrice),0);

  document.getElementById('statsSummary').innerHTML=`
    <div class="statGrid">
      <div class="statBox"><span>Beni in Magazzino</span><b>${magItems.length} pz</b></div>
      <div class="statBox"><span>Valore Magazzino</span><b>${valMag.toFixed(2)} €</b></div>
      <div class="statBox"><span>Beni Personali</span><b>${persItems.length} pz (${valPers.toFixed(2)} €)</b></div>
      <div class="statBox"><span>Beni Venduti (Spediti)</span><b>${venItems.length} pz</b></div>
      <div class="statBox"><span>Incasso Totale Venduti</span><b style="color:#22c55e">${totVen.toFixed(2)} €</b></div>
      <div class="statBox"><span>In Attesa Spedizione</span><b>${shipItems.length} pz (${totShip.toFixed(2)} €)</b></div>
    </div>
  `;

  // Calcolo annuale: partenza Ottobre 2026 (2026 = 3 mesi: Ott, Nov, Dic; dal 2027 = 12 mesi)
  let yearTotals={};
  let monthMap={};
  let totFromStart=0;

  venItems.forEach(o=>{
    let iso=o.soldAt||o.shippedAt||'';
    let dt=iso?new Date(iso):new Date(Number(o.id)||Date.now());
    let y=dt.getFullYear();
    let m=dt.getMonth()+1;
    let ym=`${y}-${String(m).padStart(2,'0')}`;
    let amt=parseEuro(o.soldPrice);

    if(y>2026 || (y===2026 && m>=10)){
      totFromStart+=amt;
      yearTotals[y]=(yearTotals[y]||0)+amt;
      monthMap[ym]=(monthMap[ym]||0)+amt;
    }else{
      let key=ym||'Pre-Ott2026';
      monthMap[key]=(monthMap[key]||0)+amt;
    }
  });

  if(!yearTotals[2026])yearTotals[2026]=0;
  let yearsSorted=Object.keys(yearTotals).map(Number).sort((a,b)=>a-b);
  let annualHtml=`<h3 style="margin-top:0;color:#facc15">Rendimento Annuale (da Ottobre 2026)</h3>
    <p style="font-size:12px;color:#9aa3b2;margin-top:0">Totale cumulato dall'inizio (Ott 2026): <b style="color:#22c55e">${totFromStart.toFixed(2)} €</b></p>`;

  yearsSorted.forEach(yr=>{
    let totYr=yearTotals[yr]||0;
    let monthsDivisor=(yr===2026)?3:12;
    let labelPeriod=(yr===2026)?'su 3 mesi (Ott–Dic 2026)':'su 12 mesi (Gen–Dic)';
    let avgMonthly=totYr/monthsDivisor;
    annualHtml+=`
      <div class="chunkRow">
        <div>
          <b>Anno ${yr}</b> <span style="font-size:11px;color:#9aa3b2">(${labelPeriod})</span><br>
          <span style="font-size:12px;color:#cbd5e1">Media mensile: <b>${avgMonthly.toFixed(2)} €/mese</b></span>
        </div>
        <b style="font-size:16px;color:#22c55e">${totYr.toFixed(2)} €</b>
      </div>
    `;
  });
  document.getElementById('statsAnnualBox').innerHTML=annualHtml;

  let platMap={};
  venItems.forEach(o=>{
    let p=o.soldPlat||'Altro';
    if(!platMap[p])platMap[p]={count:0,eur:0};
    platMap[p].count++;
    platMap[p].eur+=parseEuro(o.soldPrice);
  });
  let platLabels=Object.keys(platMap);
  if(chartPlatObj)chartPlatObj.destroy();
  chartPlatObj=new Chart(document.getElementById('chartPlat'),{
    type:'bar',
    data:{
      labels:platLabels.map(p=>`${p} (${platMap[p].count} pz - ${platMap[p].eur.toFixed(0)}€)`),
      datasets:[{label:'Incasso (€)',data:platLabels.map(p=>platMap[p].eur),backgroundColor:'#3b82f6'}]
    }
  });

  let sortedMonths=Object.keys(monthMap).sort();
  if(chartMonthObj)chartMonthObj.destroy();
  chartMonthObj=new Chart(document.getElementById('chartMonth'),{
    type:'bar',
    data:{
      labels:sortedMonths,
      datasets:[{label:'Venduto (€)',data:sortedMonths.map(k=>monthMap[k]),backgroundColor:'#22c55e'}]
    }
  });

  document.getElementById('statsDetails').innerHTML=`<h3 style="margin:12px 10px 4px">Elenco Beni Venduti (${venItems.length})</h3>`+
    (venItems.length?venItems.map(o=>{
      let dStr=o.soldAt?new Date(o.soldAt).toLocaleDateString('it-IT'):'N/D';
      return `<div class="card"><b>${o.n}</b><br><span style="font-size:12px;color:#9aa3b2">Prezzo: <b style="color:#22c55e">${o.soldPrice} €</b> • Piattaforma: <b>${o.soldPlat||'Altro'}</b> • Data: ${dStr}</span></div>`;
    }).join(''):'<div class="card" style="color:#9aa3b2">Nessun bene venduto registrato.</div>');
}
function closeStats(){document.getElementById('statsModal').classList.remove('on');}

function render(){
  let q=(document.getElementById('q').value||'').toLowerCase().trim();
  let list=D.filter(o=>{
    if(TAB=='mag'&&!(o.st=='mag' && !o.zip && !o.personal))return false;
    if(TAB=='all'&&!(o.st=='mag' && !o.personal))return false;
    if(TAB=='pers'&&!(o.st=='mag' && o.personal))return false;
    if(TAB=='ship'&&o.st!='ship')return false;
    if(TAB=='ven'&&o.st!='ven')return false;
    if(q){
      let hay=`${o.n||''} ${o.sc||''} ${o.de||''} ${o.no||''} ${o.soldPlat||''}`.toLowerCase();
      if(!hay.includes(q))return false;
    }
    return true;
  });
  document.getElementById('L').innerHTML=list.length?list.map(o=>`
    <div class="card ${o.personal?'pers':''}">
      <div style="display:flex;justify-content:space-between;gap:8px;align-items:flex-start">
        <div>
          <b style="font-size:16px">${o.n}</b><br>
          <span style="font-size:12px;color:#9aa3b2">Scatola: <b>${o.sc}</b>${o.sc=='SFUSO'&&o.po?` (${o.po})`:''} • Prezzo: <b>${o.prc||'-'}</b></span>
        </div>
        <span class="badge ${o.st=='ven'?'sold':(o.st=='ship'?'ship':(o.personal?'pers':(o.zip?'ok':'new')))}">${o.st=='ven'?'VENDUTO':(o.st=='ship'?'DA SPEDIRE':(o.personal?'PERSONALE':(o.zip?'IN ZIP':'NUOVO')))}</span>
      </div>
      ${(o.im&&o.im.length)?`<div class="thumbs">${o.im.map(s=>`<div class=th><img src="${s}"></div>`).join('')}</div>`:''}
      ${o.de?`<p style="font-size:13px;color:#cbd5e1;margin:8px 0 0;white-space:pre-line">${o.de.slice(0,220)}${o.de.length>220?'...':''}</p>`:''}
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px">
        <button class="s" onclick="openModal(${o.id})">Modifica</button>
        ${o.st=='mag'?`<button class="g s" onclick="openSellModal(${o.id})">Vendi</button>`:''}
        ${o.st=='ship'?`<button class="b s" onclick="openShipModal(${o.id})">Gestisci Spedizione</button>`:''}
        <button class="s" onclick="togglePers(${o.id})">${o.personal?'Togli ⭐':'⭐ Pers.'}</button>
        <button class="fb s" onclick="toggleFb(${o.id})">${o.fbDone?'✓ FB':'FB'}</button>
        <button class="d s" onclick="delItem(${o.id})" style="color:#ef4444">Elimina</button>
      </div>
    </div>
  `).join(''):`<div class="card" style="text-align:center;color:#9aa3b2">Nessun articolo in questa visualizzazione.</div>`;
}

loadDB();
