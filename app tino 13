function cleanFbPromo(text){
  let lines=String(text||'').split('\n');
  let filtered=lines.filter(l=>{
    let u=l.toUpperCase();
    return !u.includes('VISITA LA PAGINA FACEBOOK') && !u.includes('DI TUTTO UN PO');
  });
  return filtered.join('\n').replace(/^\n+|\n+$/g,'').trim();
}

function parseAIInput(){
  let txt=document.getElementById('wizAIInput').value.trim();
  if(!txt)return;
  let marketPart="";
  let mainPart=txt;
  let marketIndex=txt.toUpperCase().indexOf("ANALISI DI MERCATO");
  if(marketIndex!==-1){
    marketPart=txt.substring(marketIndex).trim();
    mainPart=txt.substring(0,marketIndex).trim();
  }
  let lines=mainPart.split('\n').map(l=>l.trim()).filter(Boolean);
  if(lines.length>0){
    let title=lines[0].toLowerCase();
    document.getElementById('wizNome').value=title;
    let rest=cleanFbPromo(lines.slice(1).join('\n'));
    document.getElementById('wizDesc').value=FB_PROMO_TEXT+(rest?'\n\n'+rest:'');
  }
  if(marketPart){
    document.getElementById('wizMarket').value=marketPart;
  }
}

function wizNext(){
  hideKeyboard();
  if(WIZ_STEP==1){
    exitCameraAndNext();
    return;
  }
  if(WIZ_STEP==2){
    let sc=document.getElementById('wizSc').value.trim();
    if(!sc&&!WIZ.isSfuso){alert('Inserisci numero scatola o scegli SFUSO');return;}
    WIZ.sc=sc;
    WIZ_HISTORY.push(2);
    wizShowStep(WIZ.isSfuso?'2b':4);
    return;
  }
  if(WIZ_STEP=='2b'){
    let ps=document.getElementById('wizPoSfuso').value.trim();
    if(!ps){alert('Dove si trova sfuso?');return;}
    WIZ.poSfuso=ps;
    WIZ_HISTORY.push('2b');
    wizShowStep(4);
    return;
  }
  if(WIZ_STEP==4){
    let n=document.getElementById('wizNome').value.trim();
    if(!n){alert('Inserisci titolo');return;}
    WIZ.nome=n;
    WIZ.desc=document.getElementById('wizDesc').value.trim();
    WIZ_HISTORY.push(4);
    wizShowStep(5);
    return;
  }
  if(WIZ_STEP==5){
    WIZ.desc=document.getElementById('wizDesc').value.trim();
    WIZ_HISTORY.push(5);
    wizShowStep(6);
    return;
  }
  if(WIZ_STEP==6){
    let pr=document.getElementById('wizPrezzo').value.trim();
    if(!pr||parseEuro(pr)<=0){alert('Inserisci il prezzo');return;}
    WIZ.prezzo=pr;
    WIZ.market=document.getElementById('wizMarket').value.trim();
    wizSave();
  }
}

