const FB_PROMO_TEXT = `VISITA LA PAGINA FACEBOOK "DI TUTTO UN PO'" per vedere tutti gli articoli e non perderti le novità in arrivo. Acquista più prodotti per risparmiare sui costi di spedizione.`;

let D=[],DB=null,TAB='mag',EDIT_ID=null,curIm=[],SELL_ID=null,SELL_PLAT='',SELL_SHIP='';
let WIZ={im:[],sc:'',poSfuso:'',isSfuso:false,nome:'',desc:'',market:'',prezzo:''};
let WIZ_STEP=1,WIZ_HISTORY=[],chartPlatObj=null,chartMonthObj=null,SHIP_VIEW_ID=null;
let CAM_LOOP=false,RECOG=null,VOICE_ON=false;

function openDB(){return new Promise((res,rej)=>{let r=indexedDB.open('inventario_v6_db',1);r.onupgradeneeded=e=>{try{e.target.result.createObjectStore('beni',{keyPath:'id'});}catch{}};r.onsuccess=e=>{DB=e.target.result;res(DB);};r.onerror=rej;});}

async function loadDB(){
  await openDB();
  return new Promise((res)=>{
    let tx=DB.transaction('beni','readonly');
    let store=tx.objectStore('beni');
    let req=store.getAll();
    req.onsuccess=async()=>{
      D=req.result||[];
      let need=false;
      D.forEach(o=>{
        if(o.zip==undefined){o.zip=false;need=true;}
        if(o.personal==undefined){o.personal=false;need=true;}
        if(o.soldPrice==undefined){o.soldPrice='';need=true;}
        if(o.soldPlat==undefined){o.soldPlat='';need=true;}
        if(o.shipMethod==undefined){o.shipMethod='';need=true;}
        if(o.shipOther==undefined){o.shipOther='';need=true;}
        if(o.soldAt==undefined){o.soldAt='';need=true;}
        if(o.shippedAt==undefined){o.shippedAt='';need=true;}
        if(o.st==undefined){o.st='mag';need=true;}
        if(o.marketInfo==undefined){o.marketInfo='';need=true;}
        if(o.fbDone==undefined){o.fbDone=false;need=true;}
      });
      updQuota();
      render();
      if(need)await saveDB();
      res();
    };
    req.onerror=()=>{D=[];render();res();};
  });
}

function saveDB(){
  return new Promise((res)=>{
    let tx=DB.transaction('beni','readwrite');
    let store=tx.objectStore('beni');
    store.clear();
    D.forEach(o=>store.put(o));
    tx.oncomplete=()=>{updQuota();res();};
  });
}

function parseEuro(val){
  if(val===null||val===undefined)return 0;
  let s=String(val).replace(/[^\d,.-]/g,'').trim();
  if(!s)return 0;
  if(s.includes(',')&&s.includes('.')){
    s=s.replace(/\./g,'').replace(',','.');
  }else if(s.includes(',')){
    s=s.replace(',','.');
  }
  let n=parseFloat(s);
  return isNaN(n)?0:n;
}

function formatPosInput(el){
  let digits=String(el.value||'').replace(/\D/g,'');
  if(!digits){
    el.value='';
    return;
  }
  digits=digits.replace(/^0+/,'')||'0';
  while(digits.length<3)digits='0'+digits;
  let intPart=digits.slice(0,-2);
  let decPart=digits.slice(-2);
  el.value=intPart+','+decPart;
}

