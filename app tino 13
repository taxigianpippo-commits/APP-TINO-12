      po:isSfuso?poV:(D[idx].po||''),
      de:finalDesc,
      marketInfo:document.getElementById('marketInfo').value.trim(),
      prc:document.getElementById('prc').value.trim(),
      no:document.getElementById('no').value.trim(),
