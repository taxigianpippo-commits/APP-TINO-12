function selShip(btn){SELL_SHIP=btn.dataset.ship;document.querySelectorAll('.shipBtn').forEach(b=>b.classList.toggle('sel',b===btn));document.getElementById('shipOther').style.display=SELL_SHIP=='Altro'?'block':'none';}

async function confirmSell(){
  let amtRaw=document.getElementById('sellAmount').value.trim();
  let amtNum=parseEuro(amtRaw);
  if(amtNum<=0||!SELL_PLAT||!SELL_SHIP){alert('Inserisci importo valido, piattaforma e spedizione');return;}
  let idx=D.findIndex(x=>x.id==SELL_ID);
  if(idx!==-1){
    D[idx].st='ship';
    D[idx].soldPrice=amtNum.toFixed(2).replace('.',',');
    D[idx].soldPlat=SELL_PLAT;
    D[idx].shipMethod=SELL_SHIP;
    D[idx].shipOther=document.getElementById('shipOther').value.trim();
    D[idx].soldAt=new Date().toISOString();
  }
  await saveDB();
  closeSellModal();
  render();
}

